<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:viewmodel="clr-namespace:SpaceshipGame.ViewModel"
             x:Class="SpaceshipGame.View.AddPlayerView"
             Title="AddPlayer">
  <Grid>
    <!-- Bakgrundscanvas -->
    <skia:SKCanvasView x:Name="canvasView"
                       PaintSurface="CanvasView_PaintSurface" />

    <!-- Innehåll ovanpå canvas -->
    <Grid Padding="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Rubrik -->
      <Label Text="Add Player"
             Grid.Row="0"
             FontSize="32"
             FontAttributes="Bold"
             HorizontalOptions="Center"
             TextColor="White"
             Margin="0,40,0,10" />

      <!-- Label + Entry -->
      <StackLayout Grid.Row="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Start">

        <Entry x:Name="UsernameEntry"
               Placeholder="Choose your username"
               WidthRequest="320"
               HeightRequest="44"
               BackgroundColor="#0B1226"
               TextColor="White"
               PlaceholderColor="#88FFFFFF"
               HorizontalOptions="Center" />

        <Label Text="Choose your spaceship"
               FontSize="16"
               TextColor="White"
               HorizontalOptions="Center" />

        <!-- Left/right triangular buttons + centered image -->
        <Grid Grid.Row="2" HorizontalOptions="Center" VerticalOptions="Start"
              ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="56" />
          </Grid.ColumnDefinitions>

          <!-- Left triangular button (points: top-right, center-left, bottom-right) -->
          <Frame Grid.Column="0"
                 WidthRequest="56"
                 HeightRequest="56"
                 CornerRadius="8"
                 Padding="6"
                 HasShadow="False"
                 BackgroundColor="Transparent"
                 HorizontalOptions="Center"
                 VerticalOptions="Center">
                <Polygon Points="56,0 0,28 56,56"
                     Fill="#FF5722" />
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RotateLeftCommand}" />
            </Frame.GestureRecognizers>
          </Frame>

          <!-- Center spaceship image -->
          <Image Grid.Column="1"
                 Source="spaceship.png"
                 WidthRequest="200"
                 HorizontalOptions="Center"
                 VerticalOptions="Start" />

          <!-- Right triangular button (points: top-left, center-right, bottom-left) -->
          <Frame Grid.Column="2"
                 WidthRequest="56"
                 HeightRequest="56"
                 CornerRadius="8"
                 Padding="6"
                 HasShadow="False"
                 BackgroundColor="Transparent"
                 HorizontalOptions="Center"
                 VerticalOptions="Center">
            <Polygon Points="0,0 56,28 0,56"
                     Fill="#FF5722" />
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RotateRightCommand}" />
            </Frame.GestureRecognizers>
          </Frame>
        </Grid>

      </StackLayout>

      <!-- Spacer (fyller utrymme) -->
      <BoxView Grid.Row="2" BackgroundColor="Transparent" />

      <!-- Play-knapp längst ner -->
            <Button Text="Play"
              Grid.Row="3"
              WidthRequest="260"
              HeightRequest="56"
              HorizontalOptions="Center"
              VerticalOptions="End"
              Margin="0,0,0,30"
              CornerRadius="28"
              BackgroundColor="#FF5722"
              TextColor="White"
              AutomationId="PlayButton"
              Command="{Binding AddPlayerAndStartGameCommand}" />
        </Grid>
  </Grid>
</ContentPage>